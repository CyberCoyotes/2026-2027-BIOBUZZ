{
    // Compile-check the robot code from VS Code, without opening Android Studio.
    // Run it with:  Ctrl+Shift+B  (Mac: Cmd+Shift+B)
    // Errors show up in the Problems panel and you can click them to jump to the line.
    // This only COMPILES. It does not make an APK and it does not touch the robot.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Check TeamCode compiles",
            "type": "shell",
            "command": "./gradlew :TeamCode:compileDebugJavaWithJavac --console=plain",
            "windows": {
                "command": ".\\gradlew.bat :TeamCode:compileDebugJavaWithJavac --console=plain"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "javac-gradle",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*\\.java):(\\d+): (error|warning): (.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        }
    ]
}